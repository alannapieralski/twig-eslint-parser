{
  "name": "eslint-plugin-twig-tailwind",
  "version": "0.0.0",
  "description": "Lint Tailwind CSS classes in Twig and Drupal templates. Needs eslint-plugin-better-tailwindcss as a peer dependency.",
  "license": "Apache-2.0",
  "author": "Numiko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alannapieralski/twig-lint.git",
    "directory": "packages/eslint-plugin-twig-tailwind"
  },
  "bugs": "https://github.com/alannapieralski/twig-lint/issues",
  "homepage": "https://github.com/alannapieralski/twig-lint/tree/main/packages/eslint-plugin-twig-tailwind#readme",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "twig",
    "drupal",
    "tailwindcss"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "corpus": "node ../../tools/corpus/cli.ts --package eslint-plugin-twig-tailwind"
  },
  "dependencies": {
    "twig-eslint-parser": "0.0.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "eslint-plugin-better-tailwindcss": "4.8.0"
  },
  "devDependencies": {
    "eslint-plugin-better-tailwindcss": "4.8.0",
    "tailwindcss": "4.3.3"
  }
}
