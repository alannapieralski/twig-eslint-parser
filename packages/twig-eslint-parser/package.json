{
  "name": "twig-eslint-parser",
  "version": "0.0.0",
  "description": "ESLint parser for Twig templates: HTML markup plus Twig expressions as ESTree nodes with exact source ranges.",
  "license": "Apache-2.0",
  "author": "Numiko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alannapieralski/twig-lint.git",
    "directory": "packages/twig-eslint-parser"
  },
  "bugs": "https://github.com/alannapieralski/twig-lint/issues",
  "homepage": "https://github.com/alannapieralski/twig-lint/tree/main/packages/twig-eslint-parser#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "third_party/twig-lexer/LICENSE",
    "third_party/twig-lexer/UPSTREAM.md",
    "third_party/es-html-parser/LICENSE.md",
    "third_party/es-html-parser/UPSTREAM.md"
  ],
  "keywords": [
    "eslint",
    "eslint-parser",
    "twig",
    "drupal",
    "html"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "typecheck": "tsc -b tsconfig.lexer.json tsconfig.es-html-parser.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:upstream": "node scripts/vendor.ts --test",
    "golden:twig": "php tools/twig-oracle/tokenize.php test/fixtures/twig",
    "syntax:twig": "php tools/twig-oracle/syntax.php test/fixtures/twig/twig-syntax.json",
    "vendor:check": "node scripts/vendor.ts --check",
    "vendor:write": "node scripts/vendor.ts --write",
    "corpus": "node ../../tools/corpus/cli.ts --package twig-eslint-parser"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "eslint-visitor-keys": "5.0.1",
    "espree": "11.2.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/tape": "5.8.1",
    "parse5": "8.0.1",
    "parse5-sax-parser": "8.0.0",
    "tape": "5.10.3"
  }
}
