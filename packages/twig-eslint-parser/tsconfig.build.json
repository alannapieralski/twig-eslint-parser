{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": ".tsbuild/build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/lexer", "src/es-html-parser"],
  "references": [{ "path": "./tsconfig.lexer.json" }, { "path": "./tsconfig.es-html-parser.json" }]
}
