Description: Keep comment and raw text that runs to the end of the input
 When the input ended inside a comment, a script, a style or a raw-text
 element such as textarea, the tokenizer dropped the text it had read, so
 the tree stopped at "<!--" or at the open tag and the rest of the file was
 in no node. Following the HTML tokenizer, which emits the comment or the
 text it has at the end of the file, the content is emitted as the node's
 content, and a comment without "-->" ends where its content ends. The
 node keeps no close, so callers can tell it never ended.
Author: Numiko
Origin: vendor
Forwarded: no
Test: test/parser/diagnostics.test.ts ("eof-in-comment", "x-unclosed-element")
Last-Update: 2026-10-30
---
diff --git a/src/tokenizer/handlers/comment-content.ts b/src/tokenizer/handlers/comment-content.ts
index a86c23f..e39bade 100644
--- a/src/tokenizer/handlers/comment-content.ts
+++ b/src/tokenizer/handlers/comment-content.ts
@@ -47,3 +47,21 @@ function parseCommentClose(state: TokenizerState) {
   state.currentContext = TokenizerContextTypes.Data;
   state.sourceCode.next();
 }
+
+export function handleContentEnd(state: TokenizerState) {
+  state.accumulatedContent.concatBuffer(state.decisionBuffer);
+  state.decisionBuffer.clear();
+  if (state.accumulatedContent.value() === "") {
+    return;
+  }
+
+  const position = calculateTokenPosition(state, { keepBuffer: false });
+  state.tokens.push({
+    type: TokenTypes.CommentContent,
+    value: state.accumulatedContent.value(),
+    range: position.range,
+    loc: position.loc,
+    parts: createParts(state, TokenTypes.CommentContent),
+  });
+  state.accumulatedContent.clear();
+}
