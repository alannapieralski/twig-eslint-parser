Description: Keep "/" inside an unquoted attribute value
 An unquoted attribute value ended at "/", so "href=/home" lost its value and
 "href=a/b" was read as "href=a". Following the HTML tokenizer's "attribute
 value (unquoted)" state, only whitespace and ">" end an unquoted value, and a
 "/" right after "=" starts the value. "<input value=a/>" therefore has the
 value "a/" and an open tag end of ">", as in a browser: the element is
 self-closing only because it is void, and "<div class=a/>" stays open.
Author: Numiko
Origin: vendor
Forwarded: no
Test: test/parser/parse-for-eslint.test.ts ("unquoted attribute values")
Last-Update: 2026-10-15
---
diff --git a/src/tokenizer/handlers/attribute-value-bare.ts b/src/tokenizer/handlers/attribute-value-bare.ts
index 4020d3e..8a5cc62 100644
--- a/src/tokenizer/handlers/attribute-value-bare.ts
+++ b/src/tokenizer/handlers/attribute-value-bare.ts
@@ -20,11 +20,7 @@ export function parseValueEnd(state: TokenizerState) {
 }
 
 export function parse(chars: CharsBuffer, state: TokenizerState) {
-  if (
-    isWhitespace(chars.value()) ||
-    chars.value() === ">" ||
-    chars.value() === "/"
-  ) {
+  if (isWhitespace(chars.value()) || chars.value() === ">") {
     return parseValueEnd(state);
   }
 
diff --git a/src/tokenizer/handlers/attribute-value.ts b/src/tokenizer/handlers/attribute-value.ts
index 40d8cf2..1053822 100644
--- a/src/tokenizer/handlers/attribute-value.ts
+++ b/src/tokenizer/handlers/attribute-value.ts
@@ -9,7 +9,7 @@ export function parse(chars: CharsBuffer, state: TokenizerState) {
     return parseWrapper(state);
   }
 
-  if (value === ">" || value === "/") {
+  if (value === ">") {
     return parseTagEnd(state);
   }
 
