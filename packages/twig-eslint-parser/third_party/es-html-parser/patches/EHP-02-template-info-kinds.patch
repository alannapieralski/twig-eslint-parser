-import { TemplateInfo, Token } from "../types/index.js";
+import { TemplateInfo, TemplateKind, Token } from "../types/index.js";
 import { TokenTypes } from "../constants/index.js";
 import { PartToken, TemplateToken, TokenizerState } from "../types/index.js";
-import { CharsType } from "../tokenizer/chars.js";
+import { Chars, CharsType } from "../tokenizer/chars.js";
+
+export function templateKindOf(chars: Chars | undefined): TemplateKind | undefined {
+  if (!chars?.isTemplate) {
+    return undefined;
+  }
+  return chars.wrapper?.kind ?? "print";
+}
+
+export function isAttributesTemplate(chars: Chars | undefined): boolean {
+  return chars?.isTemplate === true && chars.wrapper?.role === "attributes";
+}
+
+export function isStructuralTemplate(chars: Chars | undefined): boolean {
+  const kind = templateKindOf(chars);
+  return kind === "tag" || kind === "comment" || isAttributesTemplate(chars);
+}
 
