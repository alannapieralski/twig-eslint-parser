Description: Match vitest's format for an inline error snapshot
 Upstream runs its tests with jest, which prints a thrown error in an
 inline snapshot as its message. This package runs them with vitest, which
 prints the error's class as well. Test-only; no shipped file changes.
Author: Numiko
Origin: vendor
Forwarded: not-needed
Test: npm run test:upstream
Last-Update: 2026-10-14
---
diff --git a/src/__tests__/tokenizer/tokenizer.spec.ts b/src/__tests__/tokenizer/tokenizer.spec.ts
index a40b76d..4b33fd5 100644
--- a/src/__tests__/tokenizer/tokenizer.spec.ts
+++ b/src/__tests__/tokenizer/tokenizer.spec.ts
@@ -87,7 +87,7 @@ describe("Tokenizer", () => {
     expect(() =>
       tokenize(html, defaultTokenAdapter)
     ).toThrowErrorMatchingInlineSnapshot(
-      `"Unexpected end of tag. Expected '>' to close the opening tag. (2:2)"`
+      `[SyntaxError: Unexpected end of tag. Expected '>' to close the opening tag. (2:2)]`
     );
   });
 });
