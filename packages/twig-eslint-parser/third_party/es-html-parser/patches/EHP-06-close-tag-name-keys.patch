--- a/src/tree-constructor/handlers/tag-content.ts
+++ b/src/tree-constructor/handlers/tag-content.ts
@@ -19,10 +19,11 @@ import {
 } from "../../types/index.js";
 import {
   cloneRange,
-  parseCloseTagName,
+  closeTagNameOf,
   createNodeFrom,
