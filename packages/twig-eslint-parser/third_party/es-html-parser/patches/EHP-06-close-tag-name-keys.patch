 } from "../../utils/index.js";
 
 function handleOpenTagStart(
@@ -51,13 +52,17 @@ function handleOpenTagStart(
   return state;
 }
 
+function isClosedBy(node: { type: NodeTypes; name?: string }, closeTagName: string): boolean {
+  return node.type === NodeTypes.Tag && tagNameKey(node.name ?? "") === closeTagName;
+}
+
 function handleCloseTag(
   state: ConstructTreeState<ContextualTagNode>,
   token: AnyToken
 ) {
-  const closeTagName = parseCloseTagName(token.value);
+  const closeTagName = tagNameKey(closeTagNameOf(token));
 
-  if (closeTagName !== state.currentNode.name) {
+  if (!isClosedBy(state.currentNode, closeTagName)) {
     state.caretPosition++;
 
     return state;
diff --git a/src/utils/tag-name.ts b/src/utils/tag-name.ts
index c27bc00..e5dd4d9 100644
--- a/src/utils/tag-name.ts
+++ b/src/utils/tag-name.ts
@@ -1,5 +1,6 @@
 import { TokenTypes } from "../constants/index.js";
 import { CharsBuffer } from "../tokenizer/chars-buffer.js";
+import { parseCloseTagName } from "./parse-close-tag-name.js";
 import { parseOpenTagName } from "./parse-open-tag-name.js";
 
 type NamedToken = {
@@ -40,3 +41,14 @@ export function tagNameOf(token: NamedToken): string {
   }
   return nameBeforeGluedTemplate(namePartsOf(token), /^</);
 }
+
+export function closeTagNameOf(token: NamedToken): string {
+  if (!token.parts || token.parts.length === 0) {
+    return parseCloseTagName(token.value);
+  }
+  return nameBeforeGluedTemplate(namePartsOf(token), /^<\//);
+}
+
+export function tagNameKey(name: string): string {
+  return name.replace(/\s+/g, "").replace(/\/$/, "").toLowerCase();
+}
