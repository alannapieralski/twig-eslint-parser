Description: Keep template blocks opaque inside raw text
 The script, style and raw-content handlers matched their closing tag
 against a decision buffer that could hold a whole template block, so a
 Twig string such as '</script>' inside a template ended the element early.
 A buffer holding a template now goes straight into the content. Custom
 raw-content tag names are escaped and matched without regard to case.
Author: Numiko
Origin: vendor
Forwarded: no
Test: test/parser/parse-for-eslint.test.ts ("Twig as part of the markup structure")
Last-Update: 2026-10-14
---
diff --git a/src/tokenizer/handlers/custom-tag-raw-content.ts b/src/tokenizer/handlers/custom-tag-raw-content.ts
index c15051e..5624783 100644
--- a/src/tokenizer/handlers/custom-tag-raw-content.ts
+++ b/src/tokenizer/handlers/custom-tag-raw-content.ts
@@ -8,6 +8,12 @@ import { Range, TokenizerState } from "../../types/index.js";
 import { CharsBuffer } from "../chars-buffer.js";
 
 export function parse(chars: CharsBuffer, state: TokenizerState) {
+  if (chars.hasTemplate()) {
+    state.accumulatedContent.concatBuffer(state.decisionBuffer);
+    state.decisionBuffer.clear();
+    state.sourceCode.next();
+    return;
+  }
   if (
     chars.value() === "<" ||
     chars.value() === "</" ||
@@ -16,10 +22,12 @@ export function parse(chars: CharsBuffer, state: TokenizerState) {
     state.sourceCode.next();
     return;
   }
+  const tagName =
+    state.contextParams[TokenizerContextTypes.CustomTagRawContent]?.tagName ??
+    "";
   const regex = new RegExp(
-    "</" +
-      state.contextParams[TokenizerContextTypes.CustomTagRawContent]?.tagName +
-      "\\s*>"
+    "</" + tagName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\s*>",
+    "i"
   );
 
   if (regex.test(chars.value())) {
