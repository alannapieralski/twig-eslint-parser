{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": ".tsbuild/build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/lexer"],
  "references": [{ "path": "./tsconfig.lexer.json" }]
}
