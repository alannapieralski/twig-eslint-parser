Description: Lex words after "." or "|" as names, not operators
 In Twig, a word right after "." or "|" is an attribute or filter name even
 when it is also an operator: "foo.and", "x|matches", "foo.is". Since Twig
 3.24 this also holds with one whitespace between, as in "foo. and".
 twig-lexer 1.0.0 lexes these words as OPERATOR or TEST_OPERATOR.
 Mirrors Twig's lookbehind "(?<![\.\|]\s|.[\.\|])" for operators that begin
 with a letter; checked against the source before the cursor because the
 lexer matches on a substring. Twig 3.21+ lists "is" and "is not" among its
 operators, so the rule covers twig-lexer's test operators too. Level 3.
 Twig 3.1.0 to 3.23 lacked the whitespace form; this package lexes the
 newest behaviour, which only relabels a token and never moves a boundary.
Author: Numiko
Origin: other, https://github.com/twigphp/Twig/blob/v3.28.0/src/Lexer.php
Forwarded: not-needed
Twig-Reference: 3.1.0 ("(?<![\.\|])"), 3.24.0 (whitespace form)
Test: test/fixtures/twig/operators.twig lines 14 and 19 (parity with Twig 3.28.0); npm run test:upstream
Last-Update: 2026-09-23
---
diff --git a/src/main/lib/Lexer.ts b/src/main/lib/Lexer.ts
index 8f53b85..07fcd17 100644
--- a/src/main/lib/Lexer.ts
+++ b/src/main/lib/Lexer.ts
@@ -441,7 +441,7 @@ export class Lexer {
             this.pushToken("SPREAD_OPERATOR", '...');
         }
         // test operator
-        else if ((match = this.testOperatorRegExp.exec(candidate)) !== null) {
+        else if ((match = this.testOperatorRegExp.exec(candidate)) !== null && !this.isWordOperatorAfterDotOrPipe(match[0])) {
             this.pushToken("TEST_OPERATOR", match[0]);
         }
         // arrow
@@ -449,7 +449,7 @@ export class Lexer {
             this.pushToken("ARROW", match[0]);
         }
         // operator
-        else if ((match = this.operatorRegExp.exec(candidate)) !== null) {
+        else if ((match = this.operatorRegExp.exec(candidate)) !== null && !this.isWordOperatorAfterDotOrPipe(match[0])) {
             this.pushToken("OPERATOR", match[0]);
         }
         // name
@@ -642,6 +642,16 @@ export class Lexer {
         }
     }
 
+    private isWordOperatorAfterDotOrPipe(operator: string): boolean {
+        if (this.level !== 3 || !/^[A-Za-z]/.test(operator)) {
+            return false;
+        }
+
+        const precedingCharacters = this.source.substring(Math.max(0, this.cursor - 2), this.cursor);
+
+        return /(?:[.|][ \t\n\v\f\r]|.[.|])$/.test(precedingCharacters);
+    }
+
     private moveCoordinates(text: string) {
         this.cursor += text.length;
         this.column += text.length;
