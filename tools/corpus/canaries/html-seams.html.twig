<span {% if bold %}class="strong"{% endif %}>One</span>
<p {{ a }}{% if b %} id="c"{% endif %}>Two</p>
<{{ element }} class="dynamic">Three</{{element}}>
<div{{ wrapper.addClass('wrapper') }}>Four</div>
