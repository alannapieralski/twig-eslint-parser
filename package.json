{
  "name": "twig-eslint-parser-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Numiko",
  "type": "module",
  "workspaces": [
    "packages/twig-eslint-parser",
    "packages/eslint-plugin-twig-tailwind"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build -w twig-eslint-parser && npm run typecheck --workspaces",
    "test": "npm run build -w twig-eslint-parser && npm test --workspaces"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
